# ============================================================
# .env.example — 所有需要的环境变量
# 复制为 .env 并填写你自己的值
# ============================================================

# Gmail（用于 send_email / crontab_monitor 告警邮件）
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENTS=

# AI Heartbeat engine: cursor | opencode（observer.py 默认 cursor）
HEARTBEAT_ENGINE=cursor

# Cursor Agent CLI（用于 observer，engine=cursor 时）
CURSOR_AGENT_MODEL=composer-2.5
CURSOR_AGENT_TIMEOUT=3600
# CURSOR_AGENT_BIN=agent
# CURSOR_WORKSPACE=/path/to/your/workspace
# CRONTAB_MONITOR_MODEL=composer-2.5
# CURSOR_USE_RESUME_CHAT=false
# CURSOR_CREATE_CHAT_TIMEOUT=120

# OpenCode Server（用于 observer / reflector / newsletter / crontab_monitor，engine=opencode 时）
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
OPENCODE_MODEL=antigravity-gemini-3-flash
OPENCODE_MESSAGE_TIMEOUT=3600
OPENCODE_API_URL=

# Google Analytics 4（用于 ga4_metrics.py）
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Kit / ConvertKit（用于 kit_metrics.py 和 newsletter 发布）
KIT_API_KEY=

# Typefully posting（用于 typefully_post.py）
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=12345

# Typefully metrics（用于 typefully_metrics.py，需从浏览器抓取）
TYPEFULLY_AUTHORIZATION=
TYPEFULLY_ACCOUNT=
TYPEFULLY_SESSION=

# Gemini（用于图片生成）
GEMINI_API_KEY=

# 可选：Google 兼容变量（用于 Gemini）
GOOGLE_API_KEY=

# 图片生成模型覆盖（可选）
IMAGE_GENERATION_MODEL=
GEMINI_FLASH_IMAGE_MODEL=
GEMINI_PRO_IMAGE_MODEL=
GEMINI_IMAGE_GENERATION_MODEL=
GEMINI_IMAGE_UPSCALE_MODEL=
OPENAI_IMAGE_MODEL=

# OpenAI（用于 semantic_search 本地 embedding）
OPENAI_API_KEY=
