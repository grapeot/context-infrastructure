    {"type":"text","id":"title","x":280,"y":-5,"text":"Cerebras Wafer Scale Engine Generations","fontSize":24,"strokeColor":"#1e1e1e"},
    {"type":"text","id":"sub","x":300,"y":35,"text":"WSI monolithic wafer chip: CS-1 -> CS-2 -> CS-3 (no die disaggregation)","fontSize":13,"strokeColor":"#757575"},
