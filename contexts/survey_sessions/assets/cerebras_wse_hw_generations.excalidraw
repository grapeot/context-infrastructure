    {"type":"text","id":"g1b","x":15,"y":135,"text":"400K SLAC cores | 46,225 mm2","fontSize":12,"strokeColor":"#1e1e1e"},
    {"type":"text","id":"g1c","x":15,"y":160,"text":"18GB on-wafer SRAM | 9 PB/s mem bw","fontSize":12,"strokeColor":"#1e1e1e"},
